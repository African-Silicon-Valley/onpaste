{
  "name": "onpaste",
  "version": "0.1.0",
  "description": "Lightweight paste-event listener for input fields, textareas and contenteditable — with a clean callback payload.",
  "keywords": [
    "paste",
    "onpaste",
    "clipboard",
    "clipboarddata",
    "input",
    "textarea",
    "contenteditable",
    "dom",
    "events"
  ],
  "license": "MIT",
  "author": "Milton Black (https://github.com/blackdice-byte)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/African-Silicon-Valley/onpaste.git"
  },
  "bugs": {
    "url": "https://github.com/African-Silicon-Valley/onpaste/issues"
  },
  "homepage": "https://github.com/African-Silicon-Valley/onpaste#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
